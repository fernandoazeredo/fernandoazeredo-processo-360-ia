rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'fernandoazeredo64@gmail.com';
    }

    match /prompts/{promptId} {
      allow read: if resource.data.status == 'publicado';
      allow write: if isAdmin();
    }

    match /wallets/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.balanceCents == 0
        && request.resource.data.status == 'ativo';

      allow update, delete: if isAdmin();
    }

    match /walletConfig/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /professionalProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /walletLedger/{entryId} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /processos/{processoId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read, update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
